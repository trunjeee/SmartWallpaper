<Window
    x:Class="SmartWallpaper.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SmartWallpaper.Controls"
    Title="Smart Wallpaper">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Заголовок окна ===== -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                <Viewbox Width="20" Height="14">
                    <Canvas Width="20" Height="14">
                        <Path Data="M0.140698 0C0.0634566 0 0 0.0653243 0 0.144796V6.7962C0 7.09427 0.0181218 7.3923 0.0532972 7.68816C0.485919 11.2924 3.4722 14 6.99808 14H8.75046L8.752 14H11.2473C11.3245 14 11.388 13.9347 11.388 13.8552V7.20395C11.388 6.96393 11.4072 6.72376 11.4457 6.48695C11.7825 4.39351 13.5497 2.85853 15.6098 2.85812H17.0942C17.1655 2.85812 17.2233 2.91762 17.2233 2.99103V6.79605C17.2233 7.03607 17.2041 7.27624 17.1657 7.51305C16.8288 9.6065 15.0616 11.1415 13.0015 11.1419H12.5479C12.4706 11.1419 12.4075 11.2071 12.4075 11.2867V13.855C12.4075 13.9347 12.4706 14 12.5479 14H13.0019C16.5278 14 19.5141 11.2924 19.9467 7.68816C19.9819 7.3923 20 7.09427 20 6.7962V0.144796C20 0.0653243 19.9365 0 19.8593 0H17.364L17.3625 8.74578e-06H15.6094C12.0835 8.74578e-06 9.09722 2.70761 8.6646 6.31184C8.62943 6.6077 8.61131 6.90573 8.61131 7.2038V11.009C8.61131 11.0824 8.5535 11.1419 8.48219 11.1419H6.99847C4.93835 11.1415 3.17123 9.6065 2.83435 7.51305C2.79591 7.27624 2.77666 7.03607 2.77666 6.79605V2.99117C2.77666 2.91776 2.83447 2.85826 2.90577 2.85826L7.45179 2.85826C7.529 2.85826 7.59246 2.79294 7.59246 2.71343V0.144892C7.59246 0.0653826 7.529 6.25868e-05 7.45179 6.25833e-05L2.64009 6.23668e-05L2.63596 0H0.140698Z" Fill="#D9D9D9" />
                    </Canvas>
                </Viewbox>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="#D9D9D9"
                    Text="Smart Wallpaper" />
            </StackPanel>
        </Grid>

        <!-- ===== Схема мониторов + настройки выбранного ===== -->
        <Grid
            Grid.Row="1"
            Padding="16,0,16,0"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Border
                Background="#0DFFFFFF"
                BorderBrush="#14FFFFFF"
                BorderThickness="1"
                CornerRadius="12">
                <Grid>
                    <TextBlock
                        Margin="20,16,0,0"
                        FontFamily="{StaticResource AppFontSemiBold}"
                        FontSize="16"
                        Text="Мониторы" />
                    <TextBlock
                        Margin="20,40,0,0"
                        FontSize="12"
                        Foreground="#99FFFFFF"
                        Text="Расположены так же, как у вас на столе. Нажмите на монитор или перетащите на него картинку" />
                    <controls:MonitorLayoutPanel x:Name="LayoutPanel" Margin="0,60,0,0" />
                </Grid>
            </Border>

            <!-- Настройки выбранного монитора -->
            <StackPanel
                Grid.Column="1"
                Spacing="16"
                Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border
                            Width="28"
                            Height="28"
                            Background="{StaticResource AccentLimeBrush}"
                            CornerRadius="14">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource AppFontSemiBold}"
                                FontSize="15"
                                Foreground="#171717"
                                Text="{x:Bind ViewModel.Selected.Number, Mode=OneWay}" />
                        </Border>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource AppFontSemiBold}"
                            FontSize="20"
                            Text="{x:Bind ViewModel.Selected.Name, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock
                        Margin="38,0,0,0"
                        FontSize="12"
                        Foreground="#99FFFFFF"
                        Text="{x:Bind ViewModel.Selected.ResolutionText, Mode=OneWay}" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock FontSize="12" Foreground="#99FFFFFF" Text="Картинка" />
                    <TextBlock
                        FontFamily="{StaticResource AppFontSemiBold}"
                        Text="{x:Bind FileLabel(ViewModel.Selected.OriginalName), Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Выбрать картинку"
                            Click="PickImage_Click"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE8B9;" />
                                <TextBlock FontFamily="{StaticResource AppFontSemiBold}" Text="Выбрать картинку…" />
                            </StackPanel>
                        </Button>
                        <Button
                            Grid.Column="1"
                            AutomationProperties.Name="Убрать картинку"
                            Command="{x:Bind ViewModel.ClearImageCommand}"
                            IsEnabled="{x:Bind ViewModel.Selected.HasImage, Mode=OneWay}"
                            ToolTipService.ToolTip="Убрать картинку">
                            <FontIcon FontSize="14" Glyph="&#xE74D;" />
                        </Button>
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock FontSize="12" Foreground="#99FFFFFF" Text="Как разместить" />
                    <RadioButtons SelectedIndex="{x:Bind ViewModel.SelectedFitIndex, Mode=TwoWay}">
                        <RadioButton>
                            <StackPanel>
                                <TextBlock Text="Заполнить" />
                                <TextBlock FontSize="11" Foreground="#99FFFFFF" Text="Весь экран, лишнее обрезается по краям" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton>
                            <StackPanel>
                                <TextBlock Text="Вписать" />
                                <TextBlock FontSize="11" Foreground="#99FFFFFF" Text="Картинка целиком, по краям чёрные поля" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton>
                            <StackPanel>
                                <TextBlock Text="Растянуть" />
                                <TextBlock FontSize="11" Foreground="#99FFFFFF" Text="На весь экран без сохранения пропорций" />
                            </StackPanel>
                        </RadioButton>
                    </RadioButtons>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ===== Низ окна ===== -->
        <Grid
            Grid.Row="2"
            Padding="16"
            ColumnSpacing="12"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <InfoBar
                Grid.ColumnSpan="3"
                IsClosable="True"
                IsOpen="{x:Bind IsStatusOpen(ViewModel.StatusText), Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}" />

            <Button Grid.Row="1" AutomationProperties.Name="Определить мониторы" Click="Identify_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE7F4;" />
                    <TextBlock Text="Определить мониторы" />
                </StackPanel>
            </Button>

            <ToggleSwitch
                Grid.Row="1"
                Grid.Column="1"
                Margin="8,0,0,0"
                IsOn="{x:Bind ViewModel.RestoreOnLogon, Mode=TwoWay}"
                OffContent="Восстанавливать обои при входе в Windows"
                OnContent="Восстанавливать обои при входе в Windows"
                ToolTipService.ToolTip="Если после внезапного выключения ПК Windows сбросит обои, они вернутся сами при следующем входе" />

            <StackPanel
                Grid.Row="1"
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="12">
                <ProgressRing
                    Width="20"
                    Height="20"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                <Button
                    MinWidth="160"
                    AutomationProperties.Name="Применить"
                    Command="{x:Bind ViewModel.ApplyCommand}"
                    Style="{StaticResource AccentButtonStyle}">
                    <TextBlock FontFamily="{StaticResource AppFontSemiBold}" Text="Применить" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
