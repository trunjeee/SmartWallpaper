<UserControl
    x:Class="SmartWallpaper.Controls.MonitorTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AllowDrop="True"
    DragLeave="OnDragLeave"
    DragOver="OnDragOver"
    Drop="OnDrop"
    PointerEntered="OnPointerEntered"
    PointerExited="OnPointerExited">

    <Grid
        x:Name="Frame"
        Background="#FF161616"
        BorderThickness="2"
        CornerRadius="10">

        <!-- Превью ровно так, как картинка ляжет на экран -->
        <Image
            Source="{x:Bind Monitor.Preview, Mode=OneWay}"
            Stretch="{x:Bind PreviewStretch(Monitor.Fit), Mode=OneWay}" />

        <!-- Пустой монитор -->
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="6"
            Visibility="{x:Bind EmptyVisibility(Monitor.HasImage), Mode=OneWay}">
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="22"
                Foreground="#80FFFFFF"
                Glyph="&#xE91B;" />
            <TextBlock
                x:Name="EmptyHint"
                HorizontalAlignment="Center"
                FontSize="12"
                Foreground="#80FFFFFF"
                Text="Перетащите картинку или нажмите"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- Затемнение снизу, чтобы подпись читалась на любой картинке -->
        <Rectangle Height="56" VerticalAlignment="Bottom">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#00000000" />
                    <GradientStop Offset="1" Color="#B0000000" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <StackPanel
            Margin="10,0,10,8"
            VerticalAlignment="Bottom"
            Orientation="Horizontal"
            Spacing="8">
            <Border
                Width="24"
                Height="24"
                Background="{StaticResource AccentLimeBrush}"
                CornerRadius="12">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource AppFontSemiBold}"
                    FontSize="13"
                    Foreground="#171717"
                    Text="{x:Bind Monitor.Number}" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock
                    FontFamily="{StaticResource AppFontSemiBold}"
                    FontSize="13"
                    Foreground="White"
                    Text="{x:Bind Monitor.Name}" />
                <TextBlock
                    FontSize="11"
                    Foreground="#B3FFFFFF"
                    Text="{x:Bind Monitor.ResolutionText}" />
            </StackPanel>
        </StackPanel>

        <Border
            Margin="8"
            Padding="8,2"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="#B0000000"
            CornerRadius="8"
            Visibility="{x:Bind PrimaryVisibility(Monitor.IsPrimary)}">
            <TextBlock FontSize="11" Foreground="White" Text="Основной" />
        </Border>
    </Grid>
</UserControl>
