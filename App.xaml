<Application
    x:Class="SmartWallpaper.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="AppFont">ms-appx:///Assets/Fonts/Manrope-Medium.ttf#Manrope</FontFamily>
            <FontFamily x:Key="AppFontSemiBold">ms-appx:///Assets/Fonts/Manrope-SemiBold.ttf#Manrope</FontFamily>
            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/Manrope-Medium.ttf#Manrope</FontFamily>

            <SolidColorBrush x:Key="AccentLimeBrush" Color="#BCFF21" />

            <!-- Акцентные кнопки (Применить, Выбрать картинку) — фирменный лаймовый цвет из первой версии -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#BCFF21" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#C9FF4D" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#A6E01D" />
            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#33BCFF21" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#171717" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#171717" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#171717" />
            <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#80FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="Transparent" />

            <!-- Переключатели и радиокнопки тоже в фирменном цвете -->
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#BCFF21" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#C9FF4D" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#A6E01D" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#171717" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#171717" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#171717" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="#BCFF21" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" Color="#C9FF4D" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPressed" Color="#A6E01D" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="#BCFF21" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="#C9FF4D" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePressed" Color="#A6E01D" />
            <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="#171717" />
            <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPointerOver" Color="#171717" />
            <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPressed" Color="#171717" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
